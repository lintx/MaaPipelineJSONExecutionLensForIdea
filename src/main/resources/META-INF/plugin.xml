<idea-plugin>
    <id>com.maapipeline.json.execution.lens</id>
    <name>MaaPipeline JSON Execution Lens</name>
    <vendor email="">MaaPipeline JSON Execution Lens</vendor>

    <description><![CDATA[
        MaaFramework Pipeline JSON/JSONC navigation and execution lens for IntelliJ IDEA.
        The original Pipeline document remains the only source of truth.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.json</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileEditorProvider implementation="com.maapipeline.executionlens.pipeline.PipelineFileEditorProvider"/>
        <postStartupActivity implementation="com.maapipeline.executionlens.MaaPipelineStartupActivity"/>
        <localInspection language="JSON" shortName="MaaPipelineReference"
                         displayName="MaaPipeline 节点与 Anchor 引用"
                         groupName="MaaPipeline" enabledByDefault="true" level="WARNING"
                         implementationClass="com.maapipeline.executionlens.pipeline.PipelineReferenceInspection"/>
    </extensions>
    <actions>
        <action id="MaaPipeline.OpenWorkspace" class="com.maapipeline.executionlens.pipeline.OpenPipelineWorkspaceAction"
                text="打开 Pipeline 流程" description="在中央编辑器打开独立的 Pipeline 工作区">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="MaaPipeline.OpenFromSource" class="com.maapipeline.executionlens.pipeline.OpenPipelineFromSourceAction"
                text="从此处查看流程" description="在独立工作区查看当前 Pipeline 节点">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
