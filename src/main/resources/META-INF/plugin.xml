<idea-plugin>
    <id>com.maapipeline.json.execution.lens</id>
    <name>MaaPipeline JSON Execution Lens</name>
    <vendor email="">MaaPipeline JSON Execution Lens</vendor>

    <description><![CDATA[
        MaaFramework Pipeline JSON/JSONC navigation and execution lens for IntelliJ IDEA.
        The original Pipeline document remains the only source of truth.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.json</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileEditorProvider implementation="com.maapipeline.executionlens.pipeline.PipelineFileEditorProvider"/>
        <postStartupActivity implementation="com.maapipeline.executionlens.MaaPipelineStartupActivity"/>
    </extensions>
</idea-plugin>
